repos/
worktrees/
__pycache__/
*.pyc
# 本地新目录由代码生成，历史状态以 git 提交为准
artifacts/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
testrepo_seed/
state/dashboard_password.txt
state/dashboard_session_key

# 本地调试产物
