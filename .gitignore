lc_patch.diff
pl_patch.diff
.wrangler/
cloudflare/.wrangler/
state/tmp_*
consumer_fix.txt
cron_prompt.txt
observer_task.txt
scripts/_*

# 运行时状态：容器里的 /data/state 才是权威副本。
