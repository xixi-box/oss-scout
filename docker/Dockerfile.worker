# 统一 worker 镜像（计划 §5）：同一份执行器代码跑 Modal / GitHub Actions。
# P2 交付：含 git（按 SHA 拉仓）与 semgrep（Bug Hunter 扫描）。
FROM python:3.11-slim

# 安全基线：非 root 运行；worker 内无任何 GitHub 写令牌
RUN useradd -m worker \
    && apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir semgrep

WORKDIR /workspace

COPY scout_v2 /workspace/scout_v2
COPY configs /workspace/configs

# worker 用户需要写 artifacts；/workspace 默认归 root（P6-A 实测修复）
RUN mkdir -p /workspace/artifacts /workspace/repo && chown -R worker:worker /workspace

# OpenCode CLI 版本锁定（P4 启用；构建时复核当前版本号）
# ARG OPENCODE_VERSION=<pinned>
# RUN curl -fsSL https://opencode.ai/install | bash

USER worker
COPY docker/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
