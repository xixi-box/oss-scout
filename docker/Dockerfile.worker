# 统一 worker 镜像（计划 §5）：同一份执行器代码跑 Modal / GitHub Actions。
# P2 交付：含 git（按 SHA 拉仓）与 semgrep（Bug Hunter 扫描）。
FROM python:3.11-slim

# 安全基线：非 root 运行；worker 内无任何 GitHub 写令牌
RUN useradd -m worker \
    && apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir semgrep

WORKDIR /workspace

COPY scout_v2 /workspace/scout_v2
COPY configs /workspace/configs

# worker 用户需要写 artifacts；/workspace 默认归 root（P6-A 实测修复）
RUN mkdir -p /workspace/artifacts /workspace/repo && chown -R worker:worker /workspace

# OpenCode CLI（能力对称裁定 2026-10-25：Modal 也承载 repair）。版本锁定；
# 安装脚本的 --version 支持未经实测，首次 Modal repair 冒烟时核对落点与版本。
ARG OPENCODE_VERSION=1.18.27
RUN curl -fsSL https://opencode.ai/install | bash || true \
    && (find /root /usr/local /opt -name "opencode" -type f 2>/dev/null | head -1 | \
        xargs -r ln -sf /usr/local/bin/opencode 2>/dev/null || true)

USER worker
# --chmod：Windows 工作树不带 +x；sed 去掉 CRLF（git autocrlf 可能转换过）
COPY --chmod=0755 docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
